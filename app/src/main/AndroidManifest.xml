<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lectura de audio: permiso granular en Android 13+, almacenamiento en versiones anteriores. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Editor de etiquetas: escribir en los MP3 en Android ≤ 9 (en 10+ se usa el consentimiento del
         sistema o una carpeta concedida). Sin maxSdkVersion: algunos equipos de coche declaran un
         Android mayor que el real y el sistema no lo concedería. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <!-- Notificación de reproducción (Android 13+). Opcional: la app funciona sin ella. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Los permisos del servicio en primer plano los declara el módulo :player. -->
    <!-- Seguir con la música al encender el estéreo si la app ya no estaba abierta. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Saber si el equipo tiene selector de carpetas (para conceder la USB al editor). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
    </queries>

    <application
        android:name=".RadilloApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RadilloPlayerWave"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Respaldo de la «app de memoria» del estéreo (ver PowerOnReceiver). El aviso de la llave
             solo llega aquí si el estéreo lo envía a las apps cerradas. -->
        <receiver
            android:name=".PowerOnReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.jancar.services.action.acc" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
