<?xml version="1.0" encoding="utf-8"?>
<!-- Botón redondo sobre la carátula (corazón de favorito): disco oscuro translúcido para que se lea sobre cualquier portada o visualizador. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#E6000000" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#B3000000" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#99000000" /></shape>
    </item>
</selector>
