<?xml version="1.0" encoding="utf-8"?>
<!-- Botón con texto sobre el visualizador: cápsula translúcida que se lee sobre cualquier escena. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
