<?xml version="1.0" encoding="utf-8"?>
<!-- Icono original de RadilloPlayerWave: una onda de tres crestas que se eleva sobre un
     anillo parcial, en cian sobre fondo nocturno. Dibujado a mano para este proyecto. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anillo parcial (arco inferior) -->
    <path
        android:strokeColor="#2A3042"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M28,66 A26,26 0 0 0 80,66" />

    <!-- Onda principal -->
    <path
        android:strokeColor="#5EE7FF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M24,56 C30,56 32,36 38,36 C44,36 46,76 52,76 C58,76 60,30 66,30 C72,30 74,62 80,62 C83,62 84,58 84,56" />

    <!-- Destello magenta en la cresta más alta -->
    <path
        android:fillColor="#FF7BBF"
        android:pathData="M66,30 m-4,0 a4,4 0 1 1 8,0 a4,4 0 1 1 -8,0" />
</vector>
