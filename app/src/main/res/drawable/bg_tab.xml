<?xml version="1.0" encoding="utf-8"?>
<!-- Pestaña: subrayado de acento en la seleccionada (parece pestaña, no botón). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom" android:height="@dimen/tab_indicator">
                <shape android:shape="rectangle"><solid android:color="@color/accent" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
