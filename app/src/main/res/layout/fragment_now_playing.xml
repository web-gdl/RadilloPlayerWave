<?xml version="1.0" encoding="utf-8"?>
<!-- Móvil en vertical: carátula arriba, información, progreso, controles y extras. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/contentGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <FrameLayout
                android:id="@+id/artFrame"
                android:layout_width="@dimen/art_now_playing"
                android:layout_height="@dimen/art_now_playing"
                android:background="@color/surface_alt"
                android:clickable="true"
                android:contentDescription="@string/np_toggle_visualizer"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginTop="@dimen/space_l">

                <ImageView
                    android:id="@+id/art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <com.radillo.playerwave.visualizer.render.VisualizerSurfaceView
                    android:id="@+id/artVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/space_xl" />

            <TextView
                android:id="@+id/trackTitle"
                style="@style/Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2" />

            <TextView
                android:id="@+id/trackSubtitle"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1" />

            <SeekBar
                android:id="@+id/seek"
                style="@style/SeekBarThick"
                android:layout_marginTop="@dimen/space_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="@dimen/space_l">

                <TextView
                    android:id="@+id/position"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <!-- Qué viene después: estado visible sin abrir la cola. -->
                <TextView
                    android:id="@+id/queueInfo"
                    style="@style/Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m" />

                <TextView
                    android:id="@+id/duration"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Transporte por importancia: reproducir > anterior/siguiente > aleatorio/repetir. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnShuffle"
                    style="@style/TransportButton.Secondary"
                    android:contentDescription="@string/action_shuffle"
                    android:src="@drawable/ic_shuffle" />

                <ImageButton
                    android:id="@+id/btnPrevious"
                    style="@style/TransportButton"
                    android:layout_marginStart="@dimen/space_m"
                    android:contentDescription="@string/action_previous"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    style="@style/PlayButton"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_marginEnd="@dimen/space_l"
                    android:contentDescription="@string/action_play"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/btnNext"
                    style="@style/TransportButton"
                    android:layout_marginEnd="@dimen/space_m"
                    android:contentDescription="@string/action_next"
                    android:src="@drawable/ic_skip_next" />

                <ImageButton
                    android:id="@+id/btnRepeat"
                    style="@style/TransportButton.Secondary"
                    android:contentDescription="@string/action_repeat"
                    android:src="@drawable/ic_repeat" />
            </LinearLayout>

            <!-- Acciones secundarias con icono y texto: reconocer en vez de recordar qué hace cada icono. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/btnFavorite"
                    style="@style/LabeledAction"
                    android:contentDescription="@string/action_add_favorite">
                    <ImageView android:id="@+id/btnFavoriteIcon" style="@style/LabeledAction.Icon" android:src="@drawable/ic_favorite_border" />
                    <TextView android:id="@+id/btnFavoriteLabel" style="@style/LabeledAction.Label" android:text="@string/np_favorite" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnSleep"
                    style="@style/LabeledAction"
                    android:contentDescription="@string/sleep_timer">
                    <ImageView android:id="@+id/btnSleepIcon" style="@style/LabeledAction.Icon" android:src="@drawable/ic_bedtime" />
                    <TextView android:id="@+id/btnSleepLabel" style="@style/LabeledAction.Label" android:text="@string/np_sleep" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnEqualizer"
                    style="@style/LabeledAction"
                    android:contentDescription="@string/equalizer_title">
                    <ImageView android:id="@+id/btnEqualizerIcon" style="@style/LabeledAction.Icon" android:src="@drawable/ic_tune" />
                    <TextView android:id="@+id/btnEqualizerLabel" style="@style/LabeledAction.Label" android:text="@string/np_equalizer" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnQueue"
                    style="@style/LabeledAction"
                    android:contentDescription="@string/queue_title">
                    <ImageView android:id="@+id/btnQueueIcon" style="@style/LabeledAction.Icon" android:src="@drawable/ic_queue_music" />
                    <TextView android:id="@+id/btnQueueLabel" style="@style/LabeledAction.Label" android:text="@string/np_queue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/emptyText"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:text="@string/now_playing_empty"
        android:visibility="gone" />

</FrameLayout>
