<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_xl"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_s">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <TextView
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vis_sensitivity" />

            <TextView
                android:id="@+id/valSensitivity"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:max="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <TextView
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vis_intensity" />

            <TextView
                android:id="@+id/valIntensity"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekIntensity"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:max="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <TextView
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vis_speed" />

            <TextView
                android:id="@+id/valSpeed"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekSpeed"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:max="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <TextView
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vis_density" />

            <TextView
                android:id="@+id/valDensity"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekDensity"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:max="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <TextView
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vis_sync" />

            <TextView
                android:id="@+id/valSync"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekSync"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch"
            android:max="1000" />

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vis_palette" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/paletteChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vis_max_fps" />

        <LinearLayout
            android:id="@+id/fpsChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <Switch
            android:id="@+id/switchKeepScreenOn"
            style="@style/SettingRow"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/vis_keep_screen_on" />

        <Switch
            android:id="@+id/switchAutoQuality"
            style="@style/SettingRow"
            android:text="@string/vis_auto_quality" />

        <TextView
            android:id="@+id/autoQualityHint"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
