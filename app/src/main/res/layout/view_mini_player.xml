<?xml version="1.0" encoding="utf-8"?>
<!-- Mini reproductor: una sola fila plana, sin sombras. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player"
    android:background="@color/surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_s"
    android:paddingEnd="@dimen/space_s">

    <LinearLayout
        android:id="@+id/miniOpen"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/miniArt"
            android:layout_width="@dimen/art_row"
            android:layout_height="@dimen/art_row"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniTitle"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniSubtitle"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/miniPlay"
        style="@style/IconButton"
        android:contentDescription="@string/action_play"
        android:src="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/miniNext"
        style="@style/IconButton"
        android:contentDescription="@string/action_next"
        android:src="@drawable/ic_skip_next" />
</LinearLayout>
