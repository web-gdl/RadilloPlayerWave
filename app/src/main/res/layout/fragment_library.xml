<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/nav_library" />

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/IconButton"
            android:contentDescription="@string/action_search"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnRescan"
            style="@style/IconButton"
            android:contentDescription="@string/action_rescan"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/IconButton"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_s">

            <TextView android:id="@+id/tabSongs" style="@style/Chip" android:text="@string/tab_songs" />
            <TextView android:id="@+id/tabAlbums" style="@style/Chip" android:text="@string/tab_albums" />
            <TextView android:id="@+id/tabArtists" style="@style/Chip" android:text="@string/tab_artists" />
            <TextView android:id="@+id/tabFolders" style="@style/Chip" android:text="@string/tab_folders" />
            <TextView android:id="@+id/tabPlaylists" style="@style/Chip" android:text="@string/tab_playlists" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/scanning"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:id="@+id/btnPlayAll"
            style="@style/FlatButton"
            android:layout_marginEnd="@dimen/space_s"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="@dimen/space_s"
            android:drawableTint="@color/on_accent"
            android:text="@string/action_play_all" />

        <TextView
            android:id="@+id/btnShuffle"
            style="@style/FlatButton.Secondary"
            android:drawableStart="@drawable/ic_shuffle"
            android:drawablePadding="@dimen/space_s"
            android:drawableTint="@color/text_primary"
            android:text="@string/action_shuffle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_s"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/empty"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/permissionPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/window_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_library_music"
                android:tint="@color/accent" />

            <TextView
                style="@style/Text.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/permission_title" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:maxWidth="560dp"
                android:text="@string/permission_body" />

            <TextView
                android:id="@+id/btnGrant"
                style="@style/FlatButton"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/permission_grant" />

            <TextView
                android:id="@+id/btnOpenSettings"
                style="@style/FlatButton.Secondary"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/permission_open_settings"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
