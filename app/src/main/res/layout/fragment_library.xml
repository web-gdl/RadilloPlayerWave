<?xml version="1.0" encoding="utf-8"?>
<!--
  Biblioteca. El título «Biblioteca» sobraba (ya lo dice la navegación): su sitio lo ocupan las
  pestañas, que ahora parecen pestañas (texto subrayado) y no botones. Una sola fila de cabecera con
  el número de canciones, actualizar y las dos acciones; así caben más filas en 600 px.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/space_s">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_s">

                <TextView android:id="@+id/tabSongs" style="@style/Tab" android:text="@string/tab_songs" />
                <TextView android:id="@+id/tabAlbums" style="@style/Tab" android:text="@string/tab_albums" />
                <TextView android:id="@+id/tabArtists" style="@style/Tab" android:text="@string/tab_artists" />
                <TextView android:id="@+id/tabFolders" style="@style/Tab" android:text="@string/tab_folders" />
                <TextView android:id="@+id/tabPlaylists" style="@style/Tab" android:text="@string/tab_playlists" />
            </LinearLayout>
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/IconButton"
            android:contentDescription="@string/action_search"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/IconButton"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:id="@+id/libraryCount"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1" />

        <!-- Junto al número de canciones: «actualizar esto» (ley de proximidad). -->
        <ImageButton
            android:id="@+id/btnRescan"
            style="@style/IconButton"
            android:contentDescription="@string/action_find_new_music"
            android:src="@drawable/ic_refresh"
            android:tint="@color/text_secondary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnShuffle"
                style="@style/FlatButton.Secondary"
                android:layout_marginEnd="@dimen/space_s"
                android:drawableStart="@drawable/ic_shuffle"
                android:drawablePadding="@dimen/space_s"
                android:drawableTint="@color/text_primary"
                android:text="@string/action_shuffle" />

            <TextView
                android:id="@+id/btnPlayAll"
                style="@style/FlatButton"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="@dimen/space_s"
                android:drawableTint="@color/on_accent"
                android:text="@string/action_play_all" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/scanning"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_s"
            android:scrollbarSize="6dp"
            android:scrollbars="vertical" />

        <!-- Estado vacío con una acción concreta, no solo instrucciones. -->
        <LinearLayout
            android:id="@+id/emptyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <TextView
                android:id="@+id/empty"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="560dp" />

            <TextView
                android:id="@+id/btnEmptyAction"
                style="@style/FlatButton"
                android:layout_marginTop="@dimen/space_l"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="@dimen/space_s"
                android:drawableTint="@color/on_accent"
                android:text="@string/action_find_new_music" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/window_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_library_music"
                android:tint="@color/accent" />

            <TextView
                style="@style/Text.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/permission_title" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:maxWidth="560dp"
                android:text="@string/permission_body" />

            <TextView
                android:id="@+id/btnGrant"
                style="@style/FlatButton"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/permission_grant" />

            <TextView
                android:id="@+id/btnOpenSettings"
                style="@style/FlatButton.Secondary"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/permission_open_settings"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
