<?xml version="1.0" encoding="utf-8"?>
<!-- Ajustes ordenados por frecuencia de uso: reproducción, biblioteca, apariencia, dispositivo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/settings_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <!-- Reproducción -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_playback" />

            <Switch
                android:id="@+id/switchKeepPlaying"
                style="@style/SettingRow"
                android:text="@string/settings_keep_playing" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/space_xl"
                android:text="@string/settings_keep_playing_hint" />

            <TextView
                android:id="@+id/rowEqualizer"
                style="@style/SettingRow"
                android:layout_marginTop="@dimen/space_s"
                android:drawableStart="@drawable/ic_tune"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="@dimen/space_l"
                android:drawableTint="@color/text_secondary"
                android:text="@string/equalizer_title" />

            <!-- Biblioteca -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_library" />

            <TextView
                android:id="@+id/rowRescan"
                style="@style/SettingRow"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="@dimen/space_l"
                android:drawableTint="@color/text_secondary"
                android:text="@string/action_find_new_music" />

            <TextView
                android:id="@+id/rescanHint"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_rescan_hint" />

            <!-- Apariencia -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme" />

            <!-- Selector segmentado: las tres opciones a la vista, en una sola fila. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/themeSystem"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/theme_system" />

                <TextView
                    android:id="@+id/themeLight"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/theme_light" />

                <TextView
                    android:id="@+id/themeDark"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_weight="1"
                    android:text="@string/theme_dark" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchArtworkColors"
                style="@style/SettingRow"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_artwork_colors" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_artwork_colors_hint" />

            <!-- Dispositivo -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_device" />

            <Switch
                android:id="@+id/switchLandscape"
                style="@style/SettingRow"
                android:text="@string/settings_lock_landscape" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_lock_landscape_hint" />

            <TextView
                android:id="@+id/rowDiagnostics"
                style="@style/SettingRow"
                android:layout_marginTop="@dimen/space_s"
                android:drawableStart="@drawable/ic_content_copy"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="@dimen/space_l"
                android:drawableTint="@color/text_secondary"
                android:text="@string/settings_diagnostics" />

            <TextView
                android:id="@+id/profileText"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Acerca de -->
            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_about" />

            <TextView
                android:id="@+id/versionText"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_privacy" />

            <TextView
                android:id="@+id/rowLicenses"
                style="@style/SettingRow"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawableTint="@color/text_secondary"
                android:text="@string/settings_licenses" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
