<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/settings_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme" />

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/themeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch"
                    android:text="@string/theme_system"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/themeLight"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch"
                    android:text="@string/theme_light"
                    android:textSize="@dimen/text_body" />

                <RadioButton
                    android:id="@+id/themeDark"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch"
                    android:text="@string/theme_dark"
                    android:textSize="@dimen/text_body" />
            </RadioGroup>

            <Switch
                android:id="@+id/switchArtworkColors"
                style="@style/SettingRow"
                android:text="@string/settings_artwork_colors" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_artwork_colors_hint" />

            <Switch
                android:id="@+id/switchLandscape"
                style="@style/SettingRow"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_lock_landscape" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_lock_landscape_hint" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_audio" />

            <TextView
                android:id="@+id/rowEqualizer"
                style="@style/SettingRow"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawableTint="@color/text_secondary"
                android:text="@string/equalizer_title" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_device" />

            <TextView
                android:id="@+id/rowDiagnostics"
                style="@style/SettingRow"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawableTint="@color/text_secondary"
                android:text="@string/settings_diagnostics" />

            <TextView
                android:id="@+id/profileText"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_about" />

            <TextView
                android:id="@+id/versionText"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_privacy" />

            <TextView
                android:id="@+id/rowLicenses"
                style="@style/SettingRow"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawableTint="@color/text_secondary"
                android:text="@string/settings_licenses" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
