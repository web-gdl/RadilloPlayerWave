<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla ancha (propuesta 1, autoestéreo 1024×534 útiles): carátula grande a la izquierda,
     información y controles a la derecha, de arriba abajo por orden de lectura: qué suena → progreso →
     controles → extras en tarjetas. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

            <FrameLayout
                android:id="@+id/artFrame"
                android:layout_width="@dimen/np_art"
                android:layout_height="@dimen/np_art"
                android:background="@drawable/bg_art_rounded"
                android:clickable="true"
                android:contentDescription="@string/np_toggle_visualizer"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:id="@+id/art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <com.radillo.playerwave.visualizer.render.VisualizerSurfaceView
                    android:id="@+id/artVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trackTitle"
                style="@style/Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="@dimen/np_title" />

            <TextView
                android:id="@+id/trackSubtitle"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="@dimen/np_subtitle" />

            <SeekBar
                android:id="@+id/seek"
                style="@style/SeekBarThick"
                android:layout_marginTop="@dimen/space_l" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <!-- Qué viene después: estado visible sin abrir la cola. -->
                <TextView
                    android:id="@+id/queueInfo"
                    style="@style/Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m" />

                <TextView
                    android:id="@+id/duration"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Transporte por importancia: reproducir > anterior/siguiente > aleatorio/repetir. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnShuffle"
                    style="@style/TransportButton.Secondary"
                    android:layout_width="@dimen/np_transport_secondary"
                    android:layout_height="@dimen/np_transport_secondary"
                    android:contentDescription="@string/action_shuffle"
                    android:src="@drawable/ic_shuffle" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnPrevious"
                    style="@style/TransportButton"
                    android:layout_width="@dimen/np_transport"
                    android:layout_height="@dimen/np_transport"
                    android:contentDescription="@string/action_previous"
                    android:src="@drawable/ic_skip_previous" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    style="@style/PlayButton"
                    android:layout_width="@dimen/np_play"
                    android:layout_height="@dimen/np_play"
                    android:contentDescription="@string/action_play"
                    android:src="@drawable/ic_play" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnNext"
                    style="@style/TransportButton"
                    android:layout_width="@dimen/np_transport"
                    android:layout_height="@dimen/np_transport"
                    android:contentDescription="@string/action_next"
                    android:src="@drawable/ic_skip_next" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnRepeat"
                    style="@style/TransportButton.Secondary"
                    android:layout_width="@dimen/np_transport_secondary"
                    android:layout_height="@dimen/np_transport_secondary"
                    android:contentDescription="@string/action_repeat"
                    android:src="@drawable/ic_repeat" />
            </LinearLayout>

            <!-- Acciones secundarias con icono y texto: reconocer en vez de recordar qué hace cada icono. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/btnFavorite"
                    style="@style/LabeledCard"
                    android:contentDescription="@string/action_add_favorite">
                    <ImageView android:id="@+id/btnFavoriteIcon" style="@style/LabeledCard.Icon" android:src="@drawable/ic_favorite_border" />
                    <TextView android:id="@+id/btnFavoriteLabel" style="@style/LabeledCard.Label" android:text="@string/np_favorite" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnSleep"
                    style="@style/LabeledCard"
                    android:contentDescription="@string/sleep_timer">
                    <ImageView android:id="@+id/btnSleepIcon" style="@style/LabeledCard.Icon" android:src="@drawable/ic_bedtime" />
                    <TextView android:id="@+id/btnSleepLabel" style="@style/LabeledCard.Label" android:text="@string/np_sleep" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnEqualizer"
                    style="@style/LabeledCard"
                    android:contentDescription="@string/equalizer_title">
                    <ImageView android:id="@+id/btnEqualizerIcon" style="@style/LabeledCard.Icon" android:src="@drawable/ic_tune" />
                    <TextView android:id="@+id/btnEqualizerLabel" style="@style/LabeledCard.Label" android:text="@string/np_equalizer" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnQueue"
                    style="@style/LabeledCard"
                    android:contentDescription="@string/queue_title">
                    <ImageView android:id="@+id/btnQueueIcon" style="@style/LabeledCard.Icon" android:src="@drawable/ic_queue_music" />
                    <TextView android:id="@+id/btnQueueLabel" style="@style/LabeledCard.Label" android:text="@string/np_queue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Mismo menú «⋮» que en las listas (cola, favoritos, listas, editar etiquetas). -->
    <ImageButton
        android:id="@+id/btnMore"
        style="@style/IconButton"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_s"
        android:contentDescription="@string/cd_more"
        android:src="@drawable/ic_more_vert" />

    <TextView
        android:id="@+id/emptyText"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:text="@string/now_playing_empty"
        android:visibility="gone" />

</FrameLayout>
