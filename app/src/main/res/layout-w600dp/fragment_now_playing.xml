<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla ancha (propuesta 1, autoestéreo 1024×534 útiles): información y controles a la
     izquierda y carátula grande a la derecha. Controles de arriba abajo por orden de lectura:
     qué suena → progreso → controles → extras en tarjetas. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contentGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:saveEnabled="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">


        <!-- Columna izquierda con la misma altura que la carátula: el título arranca a su borde superior
             y las tarjetas terminan en el inferior (dos columnas parejas). -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/np_art"
            android:layout_marginEnd="40dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- «⋮» junto al título: las opciones son de esta canción (proximidad). Botón redondo
                 con fondo para que se vea como botón y sea fácil de acertar (Fitts). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/trackTitle"
                        style="@style/Text.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:includeFontPadding="false"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:textSize="@dimen/np_title" />

                    <TextView
                        android:id="@+id/trackSubtitle"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:textSize="@dimen/np_subtitle" />

                    <!-- Qué viene después: estado visible sin abrir la cola. -->
                    <TextView
                        android:id="@+id/queueInfo"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMore"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_m"
                    android:background="@drawable/bg_round_card"
                    android:contentDescription="@string/cd_more"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/icon" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Progreso como onda de sonido, con los tiempos a los lados en tamaño legible. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp" />

                <com.radillo.playerwave.ui.player.WaveformSeekView
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_marginEnd="@dimen/space_m"
                    android:layout_weight="1"
                    android:contentDescription="@string/cd_seek" />

                <TextView
                    android:id="@+id/duration"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="44dp" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Transporte por importancia: reproducir > anterior/siguiente > aleatorio/repetir.
                 Todos con zona táctil de 76dp; aleatorio y repetir muestran su estado con fondo y punto. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnShuffle"
                    style="@style/TransportButton.Secondary"
                    android:layout_width="@dimen/np_transport"
                    android:layout_height="@dimen/np_transport"
                    android:contentDescription="@string/action_shuffle"
                    android:padding="22dp"
                    android:src="@drawable/ic_shuffle" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnPrevious"
                    style="@style/TransportButton"
                    android:layout_width="@dimen/np_transport"
                    android:layout_height="@dimen/np_transport"
                    android:contentDescription="@string/action_previous"
                    android:src="@drawable/ic_skip_previous" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    style="@style/PlayButton"
                    android:layout_width="@dimen/np_play"
                    android:layout_height="@dimen/np_play"
                    android:contentDescription="@string/action_play"
                    android:src="@drawable/ic_play" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnNext"
                    style="@style/TransportButton"
                    android:layout_width="@dimen/np_transport"
                    android:layout_height="@dimen/np_transport"
                    android:contentDescription="@string/action_next"
                    android:src="@drawable/ic_skip_next" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnRepeat"
                    style="@style/TransportButton.Secondary"
                    android:layout_width="@dimen/np_transport"
                    android:layout_height="@dimen/np_transport"
                    android:contentDescription="@string/action_repeat"
                    android:padding="22dp"
                    android:src="@drawable/ic_repeat" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Acciones secundarias con icono y texto: reconocer en vez de recordar qué hace cada icono. -->
            <LinearLayout
                android:id="@+id/cardRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/btnCrossfade"
                    style="@style/LabeledCard"
                    android:contentDescription="@string/np_crossfade_toggle">
                    <ImageView android:id="@+id/btnCrossfadeIcon" style="@style/LabeledCard.Icon" android:src="@drawable/ic_crossfade" />
                    <TextView android:id="@+id/btnCrossfadeLabel" style="@style/LabeledCard.Label" android:text="@string/np_crossfade" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnEqualizer"
                    style="@style/LabeledCard"
                    android:contentDescription="@string/equalizer_title">
                    <ImageView android:id="@+id/btnEqualizerIcon" style="@style/LabeledCard.Icon" android:src="@drawable/ic_tune" />
                    <TextView android:id="@+id/btnEqualizerLabel" style="@style/LabeledCard.Label" android:text="@string/np_equalizer" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnQueue"
                    style="@style/LabeledCard"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="@string/queue_title">
                    <ImageView android:id="@+id/btnQueueIcon" style="@style/LabeledCard.Icon" android:src="@drawable/ic_queue_music" />
                    <TextView android:id="@+id/btnQueueLabel" style="@style/LabeledCard.Label" android:text="@string/np_queue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

            <FrameLayout
                android:id="@+id/artFrame"
                android:layout_width="@dimen/np_art"
                android:layout_height="@dimen/np_art"
                android:background="@drawable/bg_art_rounded"
                android:clickable="true"
                android:contentDescription="@string/np_toggle_visualizer"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:id="@+id/art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <com.radillo.playerwave.visualizer.render.VisualizerSurfaceView
                    android:id="@+id/artVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Nombre de la escena al cambiarla con doble toque o deslizando (se oculta solo). -->
                <TextView
                    android:id="@+id/artSceneLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/space_m"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_marginEnd="@dimen/space_m"
                    android:background="@drawable/bg_scene_label"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:paddingStart="@dimen/space_m"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_m"
                    android:paddingBottom="@dimen/space_s"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />
                <!-- Esquina superior derecha: con la carátula, el corazón de favorito (silueta / relleno
                     rojo); con el visualizador, el engrane de sus ajustes. Nunca los dos a la vez. -->
                <ImageView
                    android:id="@+id/btnFavorite"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/space_s"
                    android:background="@drawable/bg_art_action"
                    android:clickable="true"
                    android:contentDescription="@string/action_add_favorite"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/ic_favorite_border"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/btnVisualizerSettings"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/space_s"
                    android:background="@drawable/bg_art_action"
                    android:clickable="true"
                    android:contentDescription="@string/vis_settings"
                    android:focusable="true"
                    android:padding="14dp"
                    android:src="@drawable/ic_settings"
                    android:tint="#FFFFFFFF"
                    android:visibility="gone" />
            </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:text="@string/now_playing_empty"
        android:visibility="gone" />

</FrameLayout>
