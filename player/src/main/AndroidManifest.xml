<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Estéreos Jancar: servicio de medios del sistema al que la app se registra como fuente
         (exportado y sin permiso en el equipo). Necesario para verlo desde Android 11. -->
    <queries>
        <package android:name="com.jancar.services" />
        <!-- Ecualizador del sistema (SystemEqualizer): la app de audio del estéreo o el panel de Android. -->
        <package android:name="com.jancar.audiosettings" />
        <package android:name="com.jancar.settings" />
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <!-- Para detectar o elegir la app del ecualizador entre las del escritorio. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name="com.radillo.playerwave.player.service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Mantiene viva la app con el auto apagado mientras la música espera el encendido. -->
        <service
            android:name="com.radillo.playerwave.player.service.CarStandbyService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
